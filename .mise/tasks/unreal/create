#!/usr/bin/env python3
#MISE description="Create a minimal Unreal Engine 5.8 C++ lab"

import argparse
import json
import re
import shutil
import tempfile
from datetime import date
from pathlib import Path
from textwrap import dedent


LAB_PATH_PATTERN = re.compile(
    r"(?P<year>[0-9]{4})/(?P<month>[0-9]{2})/(?P<day>[0-9]{2})/"
    r"(?P<slug>[a-z0-9][a-z0-9-]*)"
)
PROJECT_NAME_PATTERN = re.compile(r"[A-Za-z][A-Za-z0-9]*")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Create a self-contained Unreal Engine 5.8 Blank C++ project in a new lab. "
            "Existing destinations are never overwritten."
        )
    )
    parser.add_argument("lab_path", help="lab path in YYYY/MM/DD/slug form")
    parser.add_argument("project_name", help="C++ project/module name using letters and numbers")
    parser.add_argument(
        "--title",
        help="human-readable lab title (defaults to the project name)",
    )
    parser.add_argument(
        "--root",
        type=Path,
        help="output root used for testing (defaults to this labs repository)",
    )
    return parser.parse_args()


def validate_args(args: argparse.Namespace, repository_root: Path) -> tuple[Path, str, str]:
    match = LAB_PATH_PATTERN.fullmatch(args.lab_path)
    if match is None:
        raise SystemExit("lab_path must use the exact form YYYY/MM/DD/slug")

    try:
        date(int(match["year"]), int(match["month"]), int(match["day"]))
    except ValueError as error:
        raise SystemExit(f"lab_path contains an invalid date: {error}") from error

    if PROJECT_NAME_PATTERN.fullmatch(args.project_name) is None:
        raise SystemExit("project_name must start with a letter and contain only letters and numbers")

    output_root = (args.root or repository_root).resolve()
    if not output_root.is_dir():
        raise SystemExit(f"output root does not exist: {output_root}")

    destination = (output_root / args.lab_path).resolve()
    try:
        destination.relative_to(output_root)
    except ValueError as error:
        raise SystemExit("lab_path escapes the output root") from error
    if destination.exists():
        raise SystemExit(f"destination already exists; refusing to overwrite: {destination}")

    title = args.title.strip() if args.title else args.project_name
    if not title:
        raise SystemExit("title must not be empty")

    return destination, match["slug"], title


def write_text(root: Path, relative_path: str, content: str, *, executable: bool = False) -> None:
    path = root / relative_path
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(dedent(content).lstrip(), encoding="utf-8")
    if executable:
        path.chmod(0o755)


def create_lab(staging: Path, project_name: str, title: str) -> None:
    metadata = {
        "title": title,
        "tags": ["unreal-engine"],
    }
    write_text(
        staging,
        "metadata.json",
        json.dumps(metadata, ensure_ascii=False, indent=2) + "\n",
    )

    write_text(
        staging,
        ".gitignore",
        """
        UnrealProject/Binaries/
        UnrealProject/DerivedDataCache/
        UnrealProject/Intermediate/
        UnrealProject/Saved/
        UnrealProject/*.xcodeproj/
        UnrealProject/*.xcworkspace/
        .DS_Store
        """,
    )

    write_text(
        staging,
        "README.md",
        f"""
        # {title}

        Unreal Engine 5.8 Blank C++ project generated by `mise run //:unreal:create`.

        ## Purpose and evaluation

        TODO: Define the purpose, questions or hypotheses, fixed conditions, and success criteria
        before starting the experiment.

        ## Requirements

        - Unreal Engine 5.8
        - Xcode and Command Line Tools
        - `UE_ROOT` pointing to the Unreal Engine installation

        ## Run

        ```sh
        UE_ROOT=/path/to/UE_5.8 mise run build
        UE_ROOT=/path/to/UE_5.8 mise run editor
        ```

        The Editor exposes Unreal MCP at `http://127.0.0.1:8100/mcp`.

        ## Results

        TODO: Record observed facts separately from interpretation, failed attempts, limitations,
        and the verification environment.
        """,
    )

    write_text(
        staging,
        ".mcp.json",
        """
        {
          "mcpServers": {
            "unreal": {
              "type": "http",
              "url": "http://127.0.0.1:8100/mcp"
            }
          }
        }
        """,
    )

    uproject = {
        "FileVersion": 3,
        "EngineAssociation": "5.8",
        "Category": "",
        "Description": title,
        "Modules": [
            {
                "Name": project_name,
                "Type": "Runtime",
                "LoadingPhase": "Default",
            }
        ],
        "Plugins": [
            {
                "Name": "ModelContextProtocol",
                "Enabled": True,
            },
            {
                "Name": "AllToolsets",
                "Enabled": True,
            },
        ],
    }
    write_text(
        staging,
        f"UnrealProject/{project_name}.uproject",
        json.dumps(uproject, ensure_ascii=False, indent=2) + "\n",
    )

    write_text(
        staging,
        "UnrealProject/Config/DefaultEditorPerProjectUserSettings.ini",
        """
        [/Script/ModelContextProtocolEngine.ModelContextProtocolSettings]
        ServerUrlPath=/mcp
        ServerPortNumber=8100
        bAutoStartServer=True
        bEnableToolSearch=True
        """,
    )
    write_text(
        staging,
        "UnrealProject/Config/DefaultEngine.ini",
        """
        [/Script/Engine.Engine]
        +ActiveGameNameRedirects=(OldGameName="TP_Blank",NewGameName="/Script/{project_name}")
        """.format(project_name=project_name),
    )
    write_text(
        staging,
        "UnrealProject/Config/DefaultGame.ini",
        f"""
        [/Script/EngineSettings.GeneralProjectSettings]
        ProjectName={project_name}
        Description={title}
        """,
    )

    write_text(
        staging,
        f"UnrealProject/Source/{project_name}.Target.cs",
        f"""
        using UnrealBuildTool;

        public class {project_name}Target : TargetRules
        {{
            public {project_name}Target(TargetInfo Target) : base(Target)
            {{
                Type = TargetType.Game;
                DefaultBuildSettings = BuildSettingsVersion.V7;
                IncludeOrderVersion = EngineIncludeOrderVersion.Unreal5_8;
                ExtraModuleNames.Add("{project_name}");
            }}
        }}
        """,
    )
    write_text(
        staging,
        f"UnrealProject/Source/{project_name}Editor.Target.cs",
        f"""
        using UnrealBuildTool;

        public class {project_name}EditorTarget : TargetRules
        {{
            public {project_name}EditorTarget(TargetInfo Target) : base(Target)
            {{
                Type = TargetType.Editor;
                DefaultBuildSettings = BuildSettingsVersion.V7;
                IncludeOrderVersion = EngineIncludeOrderVersion.Unreal5_8;
                ExtraModuleNames.Add("{project_name}");
            }}
        }}
        """,
    )
    write_text(
        staging,
        f"UnrealProject/Source/{project_name}/{project_name}.Build.cs",
        f"""
        using UnrealBuildTool;

        public class {project_name} : ModuleRules
        {{
            public {project_name}(ReadOnlyTargetRules Target) : base(Target)
            {{
                PCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;
                PublicDependencyModuleNames.AddRange(new[]
                {{
                    "Core",
                    "CoreUObject",
                    "Engine",
                    "InputCore"
                }});
            }}
        }}
        """,
    )
    write_text(
        staging,
        f"UnrealProject/Source/{project_name}/{project_name}.h",
        """
        #pragma once

        #include "CoreMinimal.h"
        """,
    )
    write_text(
        staging,
        f"UnrealProject/Source/{project_name}/{project_name}.cpp",
        f"""
        #include "{project_name}.h"
        #include "Modules/ModuleManager.h"

        IMPLEMENT_PRIMARY_GAME_MODULE(FDefaultGameModuleImpl, {project_name}, "{project_name}");
        """,
    )

    write_text(
        staging,
        ".mise/tasks/build",
        f"""
        #!/usr/bin/env bash
        #MISE description="Build the Unreal Editor target"

        set -euo pipefail

        : "${{UE_ROOT:?Set UE_ROOT to the Unreal Engine 5.8 installation directory}}"
        LAB_UNREAL_ROOT="$(cd "$(dirname "${{BASH_SOURCE[0]}}")/../.." && pwd)"
        LAB_UNREAL_PROJECT="${{LAB_UNREAL_ROOT}}/UnrealProject/{project_name}.uproject"
        LAB_UNREAL_BUILD="${{UE_BUILD:-${{UE_ROOT}}/Engine/Build/BatchFiles/Mac/Build.sh}}"

        if pgrep -f "UnrealEditor.*${{LAB_UNREAL_PROJECT}}" >/dev/null; then
            echo "Error: close the Editor for this project before building." >&2
            exit 1
        fi

        "${{LAB_UNREAL_BUILD}}" {project_name}Editor Mac Development \
          -Project="${{LAB_UNREAL_PROJECT}}"
        """,
        executable=True,
    )
    write_text(
        staging,
        ".mise/tasks/editor",
        f"""
        #!/usr/bin/env bash
        #MISE description="Open the Unreal project in the Editor"

        set -euo pipefail

        : "${{UE_ROOT:?Set UE_ROOT to the Unreal Engine 5.8 installation directory}}"
        LAB_UNREAL_ROOT="$(cd "$(dirname "${{BASH_SOURCE[0]}}")/../.." && pwd)"
        LAB_UNREAL_PROJECT="${{LAB_UNREAL_ROOT}}/UnrealProject/{project_name}.uproject"
        LAB_UNREAL_EDITOR="${{UE_EDITOR:-${{UE_ROOT}}/Engine/Binaries/Mac/UnrealEditor.app/Contents/MacOS/UnrealEditor}}"

        exec "${{LAB_UNREAL_EDITOR}}" "${{LAB_UNREAL_PROJECT}}" -log
        """,
        executable=True,
    )
    write_text(
        staging,
        ".mise/tasks/verify",
        """
        #!/usr/bin/env bash
        #MISE description="Verify the generated project structure"

        set -euo pipefail
        LAB_UNREAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
        python3 "${LAB_UNREAL_ROOT}/verify.py"
        """,
        executable=True,
    )
    write_text(
        staging,
        ".mise/tasks/default",
        """
        #!/usr/bin/env bash
        #MISE description="Build and verify the Unreal project"

        set -euo pipefail
        LAB_UNREAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
        mise -C "${LAB_UNREAL_ROOT}" run build
        mise -C "${LAB_UNREAL_ROOT}" run verify
        """,
        executable=True,
    )

    write_text(
        staging,
        "verify.py",
        f"""
        #!/usr/bin/env python3

        import json
        from pathlib import Path


        root = Path(__file__).resolve().parent
        project_root = root / "UnrealProject"
        project_file = project_root / "{project_name}.uproject"
        required_files = [
            project_file,
            project_root / "Config" / "DefaultEditorPerProjectUserSettings.ini",
            project_root / "Source" / "{project_name}.Target.cs",
            project_root / "Source" / "{project_name}Editor.Target.cs",
            project_root / "Source" / "{project_name}" / "{project_name}.Build.cs",
            project_root / "Source" / "{project_name}" / "{project_name}.cpp",
            project_root / "Source" / "{project_name}" / "{project_name}.h",
        ]

        missing = [str(path.relative_to(root)) for path in required_files if not path.is_file()]
        if missing:
            raise SystemExit("missing required files: " + ", ".join(missing))

        project = json.loads(project_file.read_text(encoding="utf-8"))
        modules = {{module.get("Name") for module in project.get("Modules", [])}}
        plugins = {{plugin.get("Name") for plugin in project.get("Plugins", []) if plugin.get("Enabled")}}
        if "{project_name}" not in modules:
            raise SystemExit("runtime module is not enabled in the uproject")
        for required_plugin in ("ModelContextProtocol", "AllToolsets"):
            if required_plugin not in plugins:
                raise SystemExit(f"required plugin is not enabled: {{required_plugin}}")

        generated_directories = ("Binaries", "DerivedDataCache", "Intermediate", "Saved")
        unexpected = [name for name in generated_directories if (project_root / name).exists()]
        if unexpected:
            print("generated directories present and ignored: " + ", ".join(unexpected))

        print("project structure: ok")
        print("runtime module: {project_name}")
        print("MCP endpoint: http://127.0.0.1:8100/mcp")
        """,
        executable=True,
    )


def main() -> None:
    args = parse_args()
    repository_root = Path(__file__).resolve().parents[3]
    destination, slug, title = validate_args(args, repository_root)
    destination.parent.mkdir(parents=True, exist_ok=True)

    staging = Path(tempfile.mkdtemp(prefix=f".{slug}-", dir=destination.parent))
    try:
        create_lab(staging, args.project_name, title)
        staging.replace(destination)
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise

    relative_destination = destination.relative_to((args.root or repository_root).resolve())
    print(f"created Unreal Engine lab: {relative_destination}")
    print(f"project: {relative_destination}/UnrealProject/{args.project_name}.uproject")
    print("next:")
    print(f"  UE_ROOT=/path/to/UE_5.8 mise -C {relative_destination} run verify")
    print(f"  UE_ROOT=/path/to/UE_5.8 mise -C {relative_destination} run build")


if __name__ == "__main__":
    main()
