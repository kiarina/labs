{
  "people": ["田中", "佐藤"],
  "spirits": [["ハル", "juniper"], ["ミオ", "himari"], ["ソラ", "spruce"]],
  "lines": [
    {"id": 1, "who": "田中", "to": [], "text": "佐藤さん、今度の連休どこか行く？"},
    {"id": 2, "who": "佐藤", "to": [], "text": "温泉かキャンプで迷ってるんだよね。"},
    {"id": 3, "who": "田中", "to": ["ハル"], "text": "ハル、温泉とキャンプならどっちがいいと思う？"},
    {"id": 4, "who": "佐藤", "to": ["ミオ"], "text": "ミオはどう？キャンプ派？"},
    {"id": 5, "who": "田中", "to": [], "text": "佐藤さん、車出せる？"},
    {"id": 6, "who": "佐藤", "to": [], "text": "うん、出せるよ。"},
    {"id": 7, "who": "田中", "to": ["ハル", "ミオ", "ソラ"], "text": "みんな、持っていくといい物をひとつずつ教えて。"},
    {"id": 8, "who": "佐藤", "to": ["ソラ"], "text": "ソラ、さっきハルは温泉とキャンプのどっちを勧めてた？"},
    {"id": 9, "who": "田中", "to": [], "text": "じゃあ、宿の予約は私がしておくね。"}
  ]
}
