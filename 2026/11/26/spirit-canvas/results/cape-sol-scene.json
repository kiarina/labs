 "scripts": {
  "cape-life": "const scenicViews = [\n  {cam_x: 5.2, cam_y: 5.5, cam_z: 12.5, look_x: 0, look_y: 1.55, look_z: 0, fov: 37},\n  {cam_x: -2.9, cam_y: 5.35, cam_z: 13.8, look_x: -0.35, look_y: 1.42, look_z: 0, fov: 43},\n  {cam_x: 10.1, cam_y: 4.8, cam_z: 9.8, look_x: -0.35, look_y: 1.43, look_z: 0, fov: 41}\n];\nconst easelView = {cam_x: 2.85, cam_y: 1.92, cam_z: 3.31, look_x: 1, look_y: 1.14, look_z: -0.82, fov: 34};\nlet viewIndex = 0;\nlet lookingAtEasel = false;\nlet playing = false;\nlet captionPending;\nlet globePending;\nlet gustStarted = -Infinity;\nlet spiritTouched = -Infinity;\n\nfunction camera() {\n  const aspect = sg.width / sg.height;\n  if (lookingAtEasel) return {...easelView, fov: aspect < 0.78 ? 48 : easelView.fov};\n  const view = scenicViews[viewIndex];\n  const factor = Math.max(1, Math.min(2.5, 1.42/aspect));\n  return {...view, cam_x: view.cam_x*factor, cam_z: view.cam_z*factor,\n    cam_y: view.look_y+(view.cam_y-view.look_y)*factor, fov: view.fov + (factor > 2 ? 6 : 0)};\n}\nfunction positionCamera(ms) {\n  sg.action({do: 'update', id: 'cape', props: camera(), transition_ms: ms, easing: 'ease_in_out'});\n  sg.update('cape-camera', {label: lookingAtEasel ? '全景' : '視点'});\n}\nfunction layout() {\n  const narrow = sg.width < 520;\n  const inset = narrow ? 15 : 23;\n  sg.update('cape-title', {x: inset, y: narrow ? 19 : 18, size: narrow ? 26 : 31});\n  sg.update('cape-hint', {x: inset+1, y: narrow ? 54 : 60, size: narrow ? 12 : 13, w: sg.width - inset*2});\n  sg.update('cape-note', {x: inset, y: narrow ? -69 : -18, w: narrow ? sg.width - inset*2 : Math.min(440, sg.width-246), size: narrow ? 13 : 14});\n  sg.update('cape-camera', {x: -inset});\n  sg.update('cape-music', {x: -(inset+97)});\n  positionCamera(0);\n}\nfunction hideCaption() {\n  if (captionPending) sg.cancel(captionPending);\n  sg.update('cape-note', {visible: false});\n}\nfunction caption(text, persistent = false) {\n  if (captionPending) sg.cancel(captionPending);\n  sg.update('cape-note', {text, visible: true});\n  if (!persistent) captionPending = sg.after(4200, hideCaption);\n}\nfunction breeze() {\n  gustStarted = sg.now();\n  for (let index = 0; index < 11; index++) {\n    const height = 0.42 + (index%5)*0.33;\n    const depth = -1.12 + (index%4)*0.49;\n    const startX = -6.0 + index*0.19;\n    const id = `breeze-${index}`;\n    sg.update(id, {visible: true, opacity: 0});\n    sg.animate(id, {duration_ms: 1350 + index*82, keyframes: [\n      {at: 0, x: startX, y: height, z: depth, opacity: 0},\n      {at: 0.22, x: startX+1.14, y: height+0.33, z: depth+0.52, opacity: 0.95},\n      {at: 0.65, x: startX+3.84, y: height+0.1, z: depth+0.84, opacity: 0.82},\n      {at: 1, x: startX+6.47, y: height+0.61, z: depth+1.05, opacity: 0}\n    ]});\n  }\n}\nsg.on('tap', 'windmill', () => {\n  breeze();\n  sg.sound('sounds/sfx/pop.wav', 0.23);\n  caption('風車の足もとから、風が岬を渡った。');\n});\nsg.on('tap', 'globe', () => {\n  if (globePending) sg.cancel(globePending);\n  sg.update('globe-halo', {visible: true});\n  sg.animate('globe-halo', {duration_ms: 1500, easing: 'ease_out', keyframes: [\n    {at: 0, y: 0.88, opacity: 0, scale: 0.78, ry: -24},\n    {at: 0.25, y: 1.08, opacity: 0.9, scale: 1, ry: -3},\n    {at: 1, y: 1.71, opacity: 0, scale: 1.36, ry: 37}\n  ]});\n  globePending = sg.after(1510, () => sg.update('globe-halo', {visible: false}));\n  sg.sound('sounds/sfx/chime.wav', 0.36);\n  caption('小さな地球を光がひと巡り。');\n});\nsg.on('tap', 'easel', () => {\n  lookingAtEasel = !lookingAtEasel;\n  positionCamera(1200);\n  sg.sound('sounds/sfx/click.wav', 0.24);\n  if (lookingAtEasel) caption('イーゼルの絵を眺める。もう一度タップで全景へ。', true);\n  else hideCaption();\n});\nsg.on('tap', 'spirit', () => {\n  const now = sg.now();\n  if (now-spiritTouched < 900) return;\n  spiritTouched = now;\n  sg.animate('spirit', {duration_ms: 780, easing: 'ease_in_out', keyframes: [\n    {at: 0, y: 0.04, rz: 0}, {at: 0.34, y: 0.26, rz: -9},\n    {at: 0.71, y: 0.043, rz: 5}, {at: 1, y: 0.04, rz: 0}\n  ]});\n  const line = 'ここ、いい風が吹くね。';\n  caption(line);\n  sg.speak(line, {vrm: 'spirit', id: 'cape-greeting', interrupt: true});\n});\nsg.on('press', 'cape-camera', () => {\n  if (lookingAtEasel) {\n    lookingAtEasel = false;\n    hideCaption();\n  } else {\n    viewIndex = (viewIndex + 1) % scenicViews.length;\n  }\n  positionCamera(1350);\n});\nsg.on('press', 'cape-music', () => {\n  playing = !playing;\n  sg.bgm(playing ? 'sounds/bgm/calm.wav' : null, {volume: 0.27, fade_ms: 900});\n  sg.update('cape-music', {label: playing ? '消音' : '音楽'});\n});\nsg.on('resize', 'canvas', layout);\n\nfor (let index = 0; index < 17; index++) {\n  const id = `surf-${index}`;\n  const {x,z} = sg.element(id);\n  const drift = 0.12 + index % 4 * 0.04;\n  sg.animate(id, {duration_ms: 2750 + index % 7 * 390, repeat: -1, alternate: true, easing: 'ease_in_out', keyframes: [{x, z, opacity: 0.32}, {x: x+drift, z: z+drift, opacity: 0.77}]});\n}\nsg.every(500, () => {\n  const seconds = Math.max(5, Math.min(90, Number(sg.get('capeBreezeSeconds')) || 16));\n  if (sg.now()-gustStarted >= seconds*1000) breeze();\n});\nsg.update('cape-music', {label: '音楽'});\nsg.update('globe-halo', {visible: false});\nhideCaption();\nlayout();"
 },
