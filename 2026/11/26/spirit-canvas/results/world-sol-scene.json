 "timelines": {},
 "scripts": {
  "schedule-camera": "const board = { x: -0.62, y: 1.765, z: 2.796 };\nconst wideDelay = 4200;\nconst moveDuration = 6800;\nconst aspect = () => sg.width / Math.max(1, sg.height);\n\nfunction openingCamera() {\n  const pullback = Math.max(0, 1.02 / aspect() - 1) * 3.1;\n  return { cam_x: 0.42, cam_y: 1.83, cam_z: -4.5 - pullback,\n    look_x: -0.25, look_y: 1.38, look_z: 1.7, fov: 46 };\n}\n\nfunction boardCamera() {\n  const distance = Math.max(2.44, 2.75 / aspect());\n  return { cam_x: board.x, cam_y: board.y, cam_z: board.z - distance,\n    look_x: board.x, look_y: board.y, look_z: board.z, fov: 44 };\n}\n\nlet phase = 'wide';\nlet framedAspect = aspect();\nsg.update('room', openingCamera());\nsg.after(wideDelay, () => {\n  phase = 'moving';\n  framedAspect = aspect();\n  sg.animate('room', {\n    keyframes: [{ at: 0, ...openingCamera() }, { at: 1, ...boardCamera() }],\n    duration_ms: moveDuration,\n    easing: 'ease_in_out'\n  });\n  sg.after(moveDuration, () => {\n    phase = 'board';\n    if (Math.abs(aspect() - framedAspect) > 0.05) sg.update('room', boardCamera());\n    framedAspect = aspect();\n  });\n});\n\nsg.on('resize', 'canvas', () => {\n  if (phase === 'moving' || Math.abs(aspect() - framedAspect) <= 0.05) return;\n  sg.update('room', phase === 'wide' ? openingCamera() : boardCamera());\n  framedAspect = aspect();\n});"
 },
 "saved_at": "2026-11-26T17:28:10.146914"
