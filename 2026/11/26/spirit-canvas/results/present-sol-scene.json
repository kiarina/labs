 "scripts": {
  "garden-presentation": "let slideIndex = 0;\nlet lineIndex = 0;\nlet playback = 0;\nlet slides = [];\nlet spokenId = null;\nlet finished = false;\nlet ready = false;\n\nfunction layout() {\n  const portrait = sg.height > sg.width * 1.25;\n  sg.update('garden-spirit', portrait\n    ? {x: '17%', y: '38%', w: '66%', h: '42%'}\n    : {x: '55%', y: '19%', w: '42%', h: '65%'});\n}\n\nfunction render(caption) {\n  const presentation = {index: slideIndex, count: slides.length, slide: slides[slideIndex], caption, finished};\n  sg.web('garden-deck', `window.renderGarden(${JSON.stringify(presentation)})`);\n}\n\nfunction speakLine() {\n  const line = slides[slideIndex].lines[lineIndex];\n  spokenId = `garden-${playback}-${slideIndex}-${lineIndex}`;\n  render(line);\n  sg.speak(line, {id: spokenId, vrm: 'garden-spirit', rate: 1});\n}\n\nfunction showSlide() {\n  lineIndex = 0;\n  sg.update('garden-spirit', {\n    pose: 'idle',\n    expression: slideIndex === 1 ? 'relaxed' : 'happy',\n    expression_weight: slideIndex === 1 ? 0.35 : 0.55\n  });\n  speakLine();\n}\n\nfunction start() {\n  slides = sg.get('gardenSlides');\n  if (!Array.isArray(slides) || slides.length === 0) return;\n  playback += 1;\n  slideIndex = 0;\n  finished = false;\n  showSlide();\n}\n\nfunction checkPage() {\n  sg.web('garden-deck', `if (window.renderGarden) sg.emit('ready', {finished: !document.getElementById('replay').hidden}, {wake:false})`);\n}\n\nsg.on('resize', 'canvas', layout);\nsg.on('web', 'garden-deck', (event) => {\n  const {name, data} = event.value;\n  if (name === 'ready' && !ready) {\n    ready = true;\n    sg.cancel(waitForPage);\n    if (data.finished) {\n      finished = true;\n      sg.update('garden-spirit', {pose: 'idle'});\n    } else {\n      start();\n    }\n  }\n  if (name === 'replay' && finished) start();\n});\nsg.on('spoken', '*', (event) => {\n  if (event.id !== spokenId) return;\n  spokenId = null;\n  lineIndex += 1;\n  if (lineIndex < slides[slideIndex].lines.length) {\n    speakLine();\n    return;\n  }\n  if (slideIndex + 1 < slides.length) {\n    slideIndex += 1;\n    showSlide();\n    return;\n  }\n  finished = true;\n  render('');\n});\nlayout();\nconst waitForPage = sg.every(300, checkPage);"
 },
