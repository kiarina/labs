   "html": "<!doctype html><html lang='ja'><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}body{color:#fbf4dd;background:#132b24;font-family:system-ui,'Hiragino Sans',sans-serif}main{position:relative;width:100%;height:100%;isolation:isolate;overflow:hidden;--accent:#e4ce8d;--orb:#385548;background:radial-gradient(ellipse at 80% 55%,var(--orb),transparent 60%),linear-gradient(145deg,#19362b,#11261f 75%);transition:background .4s}main[data-slide='1']{--accent:#addbd3;--orb:#2e504b}main[data-slide='2']{--accent:#f0c1a8;--orb:#4b5140}.frame{position:absolute;inset:18px;border:1px solid #f3e8ba3d;border-radius:18px;pointer-events:none}.orbit{position:absolute;z-index:-1;width:min(40vw,65vh);aspect-ratio:1;left:76%;top:51%;transform:translate(-50%,-50%);border:1px solid #f3e8ba4a;border-radius:50%;pointer-events:none}.orbit:before,.orbit:after{content:'';position:absolute;inset:7%;border:1px solid #f3e8ba26;border-radius:50%}.orbit:after{inset:-7%;border-style:dashed;border-color:#f3e8ba30}.star{position:absolute;width:12px;height:12px;background:var(--accent);clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%)}.star:nth-child(1){left:13%;top:9%}.star:nth-child(2){right:2%;top:24%;width:8px;height:8px}.star:nth-child(3){right:5%;bottom:18%;width:19px;height:19px}header{position:absolute;top:9%;left:6%;right:6%;display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--accent);font-size:clamp(11px,1.9vw,14px)}.brand{display:flex;gap:9px;align-items:center;font-family:Georgia,serif;letter-spacing:.11em}.brand i{width:9px;height:9px;border:1px solid currentColor;transform:rotate(45deg);display:block}.progress{display:flex;align-items:center;gap:6px;white-space:nowrap;font-variant-numeric:tabular-nums}.progress b{margin-left:5px;font-weight:500}.segment{width:17px;height:2px;background:#f5e9c450;border-radius:2px}.segment.current{background:var(--accent)}article{position:absolute;top:46%;left:6%;width:49%;transform:translateY(-50%)}article.enter{animation:enter .38s ease-out}@keyframes enter{from{opacity:0;transform:translateY(calc(-50% + 8px))}to{opacity:1;transform:translateY(-50%)}}h1{font-family:'Hiragino Mincho ProN','Yu Mincho',serif;font-weight:600;font-size:clamp(24px,min(6.5vw,12vh),65px);line-height:1.13;letter-spacing:-.035em;white-space:pre-line;margin:0}main[data-slide='0'] h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(35px,min(9.3vw,17vh),84px);line-height:.91}.description{color:#f3ebd6;font-size:clamp(13px,2.15vw,17px);line-height:1.65;margin:clamp(10px,4vh,20px) 0 0}.description:before{content:'';display:block;width:33px;height:1px;background:var(--accent);margin-bottom:9px}.footer{position:absolute;bottom:9%;left:6%;width:49%;min-height:3.6em;display:flex;align-items:center}.subtitle{margin:0;width:100%;padding:8px 11px;border-left:2px solid var(--accent);border-radius:0 6px 6px 0;background:#0c201b;color:#fcf6e5;font-size:clamp(12px,1.8vw,14px);line-height:1.45}.subtitle:empty{visibility:hidden}button{position:absolute;bottom:8%;right:6%;z-index:2;appearance:none;border:1px solid var(--accent);background:#11261f;color:var(--accent);padding:8px 13px;border-radius:100px;font:inherit;font-size:13px;cursor:pointer}button:focus-visible{outline:2px solid #fff;outline-offset:3px}button[hidden]{display:none}@media(max-aspect-ratio:4/5){.frame{inset:12px;border-radius:13px}header{top:6%;left:8%;right:8%}article{top:23%;left:8%;width:84%}h1{font-size:clamp(23px,min(9vw,8vh),55px)}main[data-slide='0'] h1{font-size:clamp(32px,min(13vw,10vh),74px)}.description{margin-top:10px}.description:before{margin-bottom:6px}.orbit{left:50%;top:59%;width:min(70vw,34vh)}.footer{bottom:11%;left:8%;width:84%;min-height:0}button{bottom:4%;right:8%;padding:5px 11px}}@media(max-height:340px) and (min-aspect-ratio:4/5){.frame{inset:9px}header{top:6%}article{top:45%}.description{margin-top:7px}.description:before{margin-bottom:4px}.footer{bottom:5%;min-height:0}.subtitle{padding:5px 8px}button{bottom:5%}}@media(prefers-reduced-motion:reduce){article.enter{animation:none}main{transition:none}}\n</style><main id='deck' data-slide='0'><div class='frame' aria-hidden='true'></div><div class='orbit' aria-hidden='true'><i class='star'></i><i class='star'></i><i class='star'></i></div><header><span class='brand'><i aria-hidden='true'></i>Spirits Garden</span><span class='progress'><span id='segments' aria-hidden='true'></span><b id='position'></b></span></header><article id='copy'><h1 id='slide-title'>Spirits<br>Garden</h1><p class='description' id='slide-body'>精霊と話して、遊べる場所。</p></article><div class='footer'><p class='subtitle' id='subtitle'></p></div><button id='replay' hidden>もう一度聞く</button></main><script>\nconst deck = document.getElementById('deck');\nconst copy = document.getElementById('copy');\nconst title = document.getElementById('slide-title');\nconst body = document.getElementById('slide-body');\nconst subtitle = document.getElementById('subtitle');\nconst position = document.getElementById('position');\nconst segments = document.getElementById('segments');\nconst replay = document.getElementById('replay');\nsegments.style.display = 'contents';\nlet previousSlide = -1;\nwindow.renderGarden = (presentation) => {\n  const {index, count, slide, caption, finished} = presentation;\n  if (index !== previousSlide || title.textContent !== slide.title || body.textContent !== slide.body) {\n    deck.dataset.slide = index;\n    title.textContent = slide.title;\n    body.textContent = slide.body;\n    position.textContent = `${index + 1} / ${count}`;\n    segments.replaceChildren(...Array.from({length: count}, (_, step) => {\n      const segment = document.createElement('i');\n      segment.className = step === index ? 'segment current' : 'segment';\n      return segment;\n    }));\n    copy.classList.remove('enter');\n    void copy.offsetWidth;\n    copy.classList.add('enter');\n    previousSlide = index;\n  }\n  subtitle.textContent = caption;\n  replay.hidden = !finished;\n  sg.setState({slide: index + 1, finished});\n};\nreplay.addEventListener('click', () => sg.emit('replay', {}, {wake:false}));\n</script>"
