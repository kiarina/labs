{
 "name": "mole-garden",
 "description": "Webブロックで遊ぶ3×3のもぐらたたき。BGM・効果音、折り返しと終了時の声かけ、最高記録と再挑戦つき。",
 "params": {
  "whackDuration": {
   "default": 20,
   "description": "1ラウンドの秒数（10〜120の整数）。"
  }
 },
 "background": "#F7F3E7",
 "elements": [
  {
   "id": "whack-garden",
   "type": "web",
   "x": 0,
   "y": 0,
   "w": 1280,
   "h": 800,
   "html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>もぐらたたき</title>\n<style>\n:root{color-scheme:light;--ink:#253b29;--muted:#515e47;--paper:#fffcf1;--green:#3b5937;--line:#d9d9bd;--sun:#f5d478}\n*{box-sizing:border-box}\nbody{margin:0;color:var(--ink);background:#f7f3e7;background-image:radial-gradient(#b9a77c30 1px,transparent 1px);background-size:16px 16px;font-family:'Hiragino Maru Gothic ProN','Yu Gothic',Meiryo,system-ui,sans-serif}\nbutton{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}\nbutton:focus-visible,.field:focus-visible{outline:3px solid #27472c;outline-offset:4px}\n[hidden]{display:none!important}\n.shell{max-width:1252px;margin:auto;padding:45px 42px 26px}\nheader{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:26px}\n.brand{display:flex;align-items:center;gap:17px}\n.brand-mark{width:57px;height:57px;display:grid;place-items:center;flex:none;border:1px solid #d7deb8;border-radius:19px;background:#e8eccf}\n.sprout{width:33px;height:32px;position:relative;display:inline-block}\n.sprout:before,.sprout:after{content:'';position:absolute;width:16px;height:12px;background:#648653;top:7px;left:2px;border-radius:2px 13px 2px 13px;transform:rotate(13deg)}\n.sprout:after{left:16px;top:3px;background:#456941;border-radius:13px 2px 13px 2px;transform:rotate(-12deg)}\n.sprout i{position:absolute;left:15px;top:12px;width:4px;height:14px;background:#456941;border-radius:3px;transform:rotate(8deg)}\nh1{font-size:46px;line-height:1.17;letter-spacing:.05em;margin:0;font-weight:900}\n.tagline{font-size:15px;color:var(--muted);margin:7px 0 0;font-weight:650;line-height:1.65}\n.sound{white-space:nowrap;display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:30px;background:var(--paper);padding:11px 16px;font-size:13px;font-weight:750}\n.sound span:first-child{font-size:16px;line-height:1}\n.layout{display:grid;grid-template-columns:272px minmax(0,1fr);gap:22px}\n.side{display:flex;flex-direction:column;gap:16px;min-width:0}\n.panel{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:19px;box-shadow:0 3px 0 #dfd8c452}\n.metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px}\n.metric{min-width:0}\n.metric + .metric{border-left:1px solid #e3dfca;padding-left:15px}\n.metric-label{font-size:12px;font-weight:800;color:var(--muted)}\n.number{font-variant-numeric:tabular-nums;font-size:46px;font-weight:900;line-height:1.2;letter-spacing:-.055em}\n.unit{color:var(--muted);font-size:12px;font-weight:800;margin-left:3px;letter-spacing:0}\n.meter{height:8px;background:#e9e9d6;border-radius:8px;overflow:hidden;margin-top:13px}\n.fill{height:100%;border-radius:inherit;background:#68874e;transform-origin:left;will-change:transform}\n.metrics-panel.hurry .fill{background:#c17140}\n.metrics-panel.hurry #time{color:#a55032}\n.cheer{display:flex;gap:11px;align-items:flex-start;flex:1;min-height:136px;background:#edf0d9;border-color:#d7ddbd}\n.guide{width:31px;height:31px;display:grid;place-items:center;flex:none;border-radius:50%;background:#dce7c1}\n.guide .sprout{transform:scale(.72)}\n.guide-text{padding-top:2px;min-width:0}\n.guide-title{margin:0 0 6px;font-size:12px;font-weight:850;color:#496043}\n#cheer{margin:0;font-size:15px;font-weight:750;line-height:1.65;overflow-wrap:anywhere}\n.controls{margin-top:auto}\n.primary{width:100%;background:#f5d478;border:1px solid #aa8446;border-radius:15px;min-height:52px;padding:9px 14px;font-size:17px;font-weight:900;box-shadow:0 4px 0 #aa8446}\n.primary:hover{background:#ffe095}\n.primary:active{transform:translateY(3px);box-shadow:0 1px 0 #aa8446}\n.running{display:grid;place-items:center;min-height:52px;border:1px dashed #a6b090;border-radius:15px;color:#425a3d;font-size:14px;font-weight:800;background:#edf0d9}\n.hint{margin:13px 0 1px;text-align:center;color:var(--muted);font-size:12px;font-weight:650;line-height:1.5}\n.field{position:relative;isolation:isolate;overflow:hidden;height:clamp(400px,67vh,550px);border:2px solid #6b8952;border-radius:32px;background:radial-gradient(ellipse at 43% 8%,#dbe9af 0%,transparent 63%),linear-gradient(150deg,#c7dd96,#afd180 65%,#a7c878);box-shadow:0 5px 0 #7d9d60,inset 0 0 0 6px #eff7d150}\n.field:before{position:absolute;inset:0;content:'';z-index:-1;pointer-events:none;background-image:radial-gradient(#6e8e5535 1.2px,transparent 1.5px),radial-gradient(#f9ffdf80 1px,transparent 1.4px);background-size:39px 32px,57px 49px;background-position:8px 9px,20px 23px}\n.grid{position:absolute;inset:5% 7% 5%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:4px 12px}\n.hole{position:relative;isolation:isolate;display:block;width:100%;height:100%;background:transparent;border:0;border-radius:25px;user-select:none;padding:0}\n.hole:disabled{cursor:default}\n.earth,.recess,.lip,.burrow{position:absolute;left:50%;bottom:16%;transform:translateX(-50%);width:76%;max-width:173px;pointer-events:none}\n.earth{height:29%;background:#74975266;border-radius:50%;transform:translateX(-50%) translateY(25%)}\n.recess{height:28%;border-radius:50%;background:#604633;border:6px solid #9b724b;box-shadow:0 4px 0 #795a3d,inset 0 5px 7px #372c24}\n.lip{height:28%;border-radius:50%;border-bottom:6px solid #a67b51;border-left:3px solid transparent;border-right:3px solid transparent}\n.burrow{height:81%;overflow:hidden;border-radius:0 0 49% 49% / 0 0 17% 17%}\n.mole{width:62%;max-width:96px;height:91%;max-height:100px;position:absolute;left:50%;bottom:0;transform:translate(-50%,104%);transition:transform .16s ease-in;transform-origin:bottom center;border-radius:47% 47% 37% 37%;background:radial-gradient(ellipse at 39% 26%,#ab7656 0%,#916044 55%,#714730 100%);border:2px solid #6b462e;box-shadow:inset 0 4px 0 #bd8a68}\n.hole.up .mole,.hole.sample .mole{transform:translate(-50%,5%);transition:transform .20s cubic-bezier(.2,.85,.4,1.18)}\n.hole.hit .mole{transform:translate(-50%,43%) scale(.86,.68);transition:transform .13s ease-out}\n.eyes{position:absolute;inset:31% 22% auto;display:flex;justify-content:space-between}\n.eyes i{width:11%;min-width:5px;aspect-ratio:.67;background:#2f2320;border-radius:50%;box-shadow:inset 1px 2px #fff4d5a0}\n.snout{position:absolute;left:50%;top:43%;transform:translateX(-50%);width:56%;height:34%;background:#efc3a0;border-radius:50% 50% 44% 44%;box-shadow:inset 0 -3px #cb936f}\n.nose{position:absolute;top:-7%;left:50%;width:36%;height:34%;transform:translateX(-50%);border-radius:54% 54% 64% 64%;background:#51312b;box-shadow:inset 0 2px #845447}\n.teeth{position:absolute;left:50%;top:52%;width:26%;height:32%;transform:translateX(-50%);border-radius:1px 1px 3px 3px;background:linear-gradient(90deg,#fff6de 45%,#daaf8f 45% 55%,#fff6de 55%)}\n.paw{position:absolute;bottom:0;width:22%;height:17%;background:#b4825d;border:1px solid #855d40;border-radius:55% 55% 22% 22%}\n.paw.left{left:2%;transform:rotate(-12deg)}.paw.right{right:2%;transform:rotate(12deg)}\n.plus{display:none;position:absolute;z-index:2;top:11%;right:12%;font-size:23px;font-weight:1000;color:#385129;background:#f9df8f;border:1px solid #b58d4c;border-radius:12px;padding:1px 7px;pointer-events:none}\n.hole.hit .plus{display:block;animation:score-pop .36s ease-out both}\n@keyframes score-pop{from{transform:translateY(8px) scale(.8)}to{transform:translateY(-10px) scale(1.04);opacity:0}}\n.grass,.flower{position:absolute;pointer-events:none;z-index:-1}\n.grass{width:23px;height:15px;border-radius:100% 0;background:#72964f75;transform:rotate(15deg)}\n.grass:after{content:'';position:absolute;bottom:1px;left:3px;width:13px;height:10px;border-radius:0 100%;background:#87a95e;transform:rotate(-22deg) translateX(-9px)}\n.flower{width:8px;height:8px;border-radius:50%;background:#e7a950;box-shadow:5px 0 #fff0a8,-5px 0 #fff0a8,0 5px #fff0a8,0 -5px #fff0a8}\n.record{margin:12px 0 0;text-align:right;font-size:12px;font-weight:750;color:#526649}\n.result-curtain{position:absolute;z-index:5;inset:0;display:grid;place-items:center;padding:16px;background:#334b2c61}\n.result{width:min(100%,344px);padding:22px 24px 25px;text-align:center;border-radius:22px;background:var(--paper);border:1px solid #b2b892;box-shadow:0 7px 0 #42593763}\n.result h2{margin:0;font-size:22px;font-weight:900}\n.result-score{margin:1px 0 0;font-size:66px;line-height:1.13;font-weight:950;font-variant-numeric:tabular-nums;letter-spacing:-.04em}\n.result-score .unit{font-size:19px;margin-left:6px}\n.result-note{margin:5px 0 16px;font-size:14px;font-weight:750;color:var(--muted);line-height:1.5}\n@media(max-width:900px){.shell{padding:32px 24px 20px}.layout{grid-template-columns:222px minmax(0,1fr);gap:15px}.panel{padding:15px}.grid{inset:5% 3%;gap:2px 7px}.field{border-radius:25px}}\n@media(max-width:640px){.shell{padding:16px 12px 10px}header{margin-bottom:13px;gap:8px}.brand{gap:8px}.brand-mark{width:37px;height:37px;border-radius:12px}.brand-mark .sprout{transform:scale(.8)}h1{font-size:27px}.tagline{font-size:10px;margin-top:3px}.sound{padding:7px 8px;gap:4px;font-size:11px}.layout{grid-template-columns:1fr;gap:12px}.side{display:grid;grid-template-columns:.9fr 1.1fr;gap:8px}.panel{padding:8px 10px;border-radius:14px}.metric + .metric{padding-left:7px}.metric-label,.guide-title{font-size:10px}.number{font-size:28px}.unit{font-size:10px}.meter{height:5px;margin-top:4px}.cheer{min-height:0;gap:5px}.guide{width:22px;height:22px}.guide .sprout{transform:scale(.54)}.guide-title{margin-bottom:2px}#cheer{font-size:11px;line-height:1.5}.controls{grid-column:1/-1}.primary,.running{min-height:38px;font-size:14px;border-radius:11px}.hint{margin-top:7px;font-size:10px}.field{height:clamp(243px,53vh,440px);border-radius:21px}.recess{border-width:4px}.lip{border-bottom-width:4px}.plus{font-size:16px}.record{margin-top:8px}.result{padding:14px 18px 17px}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}\n</style>\n</head>\n<body>\n<main class=\"shell\">\n<header><div class=\"brand\"><span class=\"brand-mark\" aria-hidden=\"true\"><span class=\"sprout\"><i></i></span></span><div><h1>もぐらたたき</h1><p class=\"tagline\" id=\"tagline\">顔を出したもぐらを、20秒で何匹たたけるかな？</p></div></div><button class=\"sound\" id=\"sound\" type=\"button\" aria-pressed=\"true\" aria-label=\"ゲーム音\"><span aria-hidden=\"true\">♪</span><span id=\"soundLabel\">音あり</span></button></header>\n<div class=\"layout\">\n<aside class=\"side\">\n<section class=\"panel metrics-panel\" id=\"metrics\" aria-label=\"ゲームの記録\"><div class=\"metrics\"><div class=\"metric\"><div class=\"metric-label\">スコア</div><div class=\"number\"><span id=\"score\">0</span><span class=\"unit\">匹</span></div></div><div class=\"metric\"><div class=\"metric-label\">のこり</div><div class=\"number\"><span id=\"time\">20</span><span class=\"unit\">秒</span></div></div></div><div class=\"meter\" aria-hidden=\"true\"><div id=\"fill\" class=\"fill\"></div></div></section>\n<section class=\"panel cheer\"><span class=\"guide\" aria-hidden=\"true\"><span class=\"sprout\"><i></i></span></span><div class=\"guide-text\"><p class=\"guide-title\">応援席</p><p id=\"cheer\" aria-live=\"polite\">準備ができたらスタート。見てるよ！</p></div></section>\n<div class=\"controls\"><button type=\"button\" class=\"primary\" id=\"start\">スタート</button><div class=\"running\" id=\"running\" hidden>プレイ中</div><p class=\"hint\">タップ・クリック・数字キー 1〜9</p></div>\n</aside>\n<div><section class=\"field\" id=\"field\" tabindex=\"-1\" aria-label=\"もぐらの広場\"><div class=\"grid\" id=\"grid\"></div><div class=\"result-curtain\" id=\"curtain\" hidden><div class=\"result\" role=\"group\" aria-labelledby=\"resultHeading\"><h2 id=\"resultHeading\">タイムアップ！</h2><p class=\"result-score\"><span id=\"finalScore\">0</span><span class=\"unit\">匹</span></p><p class=\"result-note\" id=\"resultNote\"></p><button type=\"button\" class=\"primary\" id=\"retry\">もう一回</button></div></div></section><p class=\"record\" id=\"record\" hidden>この画面での最高記録 <span id=\"best\">0</span> 匹</p></div>\n</div>\n</main>\n<script>\nconst byId = id => document.getElementById(id);\nconst ui = Object.fromEntries(['tagline','sound','soundLabel','metrics','score','time','fill','cheer','start','running','field','grid','curtain','finalScore','resultNote','retry','record','best'].map(id => [id, byId(id)]));\nconst config = { duration: 20 };\nlet phase = 'ready';\nlet round = 0;\nlet score = 0;\nlet best = null;\nlet midpointScore = null;\nlet appeared = 0;\nlet active = -1;\nlet previous = -1;\nlet began = 0;\nlet nextMole = 0;\nlet hidesAt = 0;\nlet timer = 0;\nlet lastFeedback = -1;\nlet feedbackUntil = 0;\nlet muted = false;\n\nconst burrow = '<span class=\"earth\"></span><span class=\"recess\"></span><span class=\"burrow\"><span class=\"mole\"><span class=\"eyes\"><i></i><i></i></span><span class=\"snout\"><i class=\"nose\"></i><i class=\"teeth\"></i></span><i class=\"paw left\"></i><i class=\"paw right\"></i></span></span><span class=\"lip\"></span><span class=\"plus\">+1</span>';\nconst holes = Array.from({length:9}, (_, index) => {\n  const button = document.createElement('button');\n  button.type = 'button';\n  button.className = 'hole';\n  button.disabled = true;\n  button.setAttribute('aria-label', `穴 ${index + 1}`);\n  const art = document.createElement('span');\n  art.setAttribute('aria-hidden','true');\n  art.innerHTML = burrow;\n  button.append(art);\n  button.addEventListener('click', () => hit(index));\n  ui.grid.append(button);\n  return button;\n});\nholes[4].classList.add('sample');\nfor (const [type,x,y] of [['grass',6,15],['flower',23,7],['grass',44,8],['grass',72,9],['flower',91,15],['flower',9,38],['grass',32,32],['grass',66,37],['grass',92,44],['grass',13,59],['flower',35,61],['grass',64,63],['flower',86,63],['grass',5,83],['flower',20,91],['grass',39,92],['grass',73,88],['flower',94,88]]) {\n  const plant = document.createElement('i');\n  plant.className = type;\n  plant.style.left = `${x}%`;\n  plant.style.top = `${y}%`;\n  plant.setAttribute('aria-hidden','true');\n  ui.field.prepend(plant);\n}\n\nconst audioUrl = path => typeof sg.asset === 'function' ? sg.asset(path) : `asset://${path}`;\nconst music = new Audio(audioUrl('sounds/bgm/adventure.wav'));\nmusic.loop = true;\nmusic.volume = .27;\nconst effect = new Audio(audioUrl('sounds/sfx/click.wav'));\neffect.volume = .58;\nconst hitSound = new Audio(audioUrl('sounds/sfx/pop.wav'));\nhitSound.volume = .58;\nconst finishUrl = audioUrl('sounds/sfx/fanfare.wav');\nfunction play(track) { track.play().catch(() => {}); }\nfunction soundEffect(track, url) {\n  if (muted) return;\n  if (url && track.src !== url) track.src = url;\n  track.currentTime = 0;\n  play(track);\n}\nfunction stopMusic() {\n  music.pause();\n  music.currentTime = 0;\n}\nui.sound.addEventListener('click', () => {\n  muted = !muted;\n  ui.sound.setAttribute('aria-pressed', String(!muted));\n  ui.soundLabel.textContent = muted ? '音なし' : '音あり';\n  if (muted) {\n    music.pause();\n    effect.pause();\n    hitSound.pause();\n  } else if (phase === 'playing') {\n    play(music);\n    soundEffect(effect, audioUrl('sounds/sfx/click.wav'));\n  }\n});\n\nfunction snapshot() {\n  const remaining = phase === 'playing' ? Math.max(0, config.duration * 1000 - (performance.now() - began)) : phase === 'ready' ? config.duration * 1000 : 0;\n  return {phase, round, duration:config.duration, score, best, midpointScore, appeared, remainingMs:Math.round(remaining), active:active + 1};\n}\nfunction publish(event) {\n  const state = snapshot();\n  sg.setState(state);\n  if (event) sg.emit(event, state, {wake:true});\n}\nfunction showTime(remaining) {\n  const seconds = Math.ceil(remaining / 1000);\n  if (ui.time.textContent !== String(seconds)) ui.time.textContent = seconds;\n  ui.fill.style.transform = `scaleX(${remaining / (config.duration * 1000)})`;\n  ui.metrics.classList.toggle('hurry', seconds <= 5);\n}\nfunction clearActive() {\n  if (active < 0) return;\n  holes[active].classList.remove('up');\n  holes[active].setAttribute('aria-label', `穴 ${active + 1}`);\n  active = -1;\n}\nfunction emerge(now, elapsed) {\n  const available = holes.length - (previous >= 0 ? 1 : 0);\n  const choice = Math.floor(Math.random() * available);\n  active = previous >= 0 && choice >= previous ? choice + 1 : choice;\n  previous = active;\n  appeared += 1;\n  holes[active].classList.remove('hit');\n  holes[active].classList.add('up');\n  holes[active].setAttribute('aria-label', `穴 ${active + 1}、もぐらが出た`);\n  hidesAt = now + 1000 - 270 * Math.min(1, elapsed / (config.duration * 1000));\n  nextMole = hidesAt + 170;\n}\nfunction hit(index) {\n  if (phase !== 'playing') return;\n  const now = performance.now();\n  if (now - began >= config.duration * 1000) {\n    finish();\n    return;\n  }\n  if (index !== active || now >= hidesAt) return;\n  if (lastFeedback >= 0) holes[lastFeedback].classList.remove('hit');\n  clearActive();\n  holes[index].classList.add('hit');\n  lastFeedback = index;\n  feedbackUntil = now + 360;\n  nextMole = now + 440;\n  score += 1;\n  ui.score.textContent = score;\n  soundEffect(hitSound);\n  publish();\n}\nfunction tick() {\n  const now = performance.now();\n  if (phase !== 'playing') return;\n  const elapsed = Math.max(0, now - began);\n  const total = config.duration * 1000;\n  if (elapsed >= total) {\n    finish();\n    return;\n  }\n  showTime(total - elapsed);\n  if (lastFeedback >= 0 && now >= feedbackUntil) {\n    holes[lastFeedback].classList.remove('hit');\n    lastFeedback = -1;\n  }\n  if (active >= 0 && now >= hidesAt) clearActive();\n  if (active < 0 && now >= nextMole) emerge(now, elapsed);\n  if (midpointScore === null && elapsed >= total / 2) {\n    midpointScore = score;\n    ui.cheer.textContent = score ? `折り返しで${score}匹！ 後半もいけるよ！` : 'あと半分！ 顔が見えた穴をねらってみよう。';\n    publish('whack_midpoint');\n  }\n}\nfunction start() {\n  if (phase === 'playing') return;\n  round += 1;\n  phase = 'playing';\n  score = 0;\n  appeared = 0;\n  midpointScore = null;\n  active = -1;\n  previous = -1;\n  lastFeedback = -1;\n  holes.forEach(hole => {\n    hole.classList.remove('sample','hit','up');\n    hole.disabled = false;\n  });\n  ui.score.textContent = '0';\n  ui.curtain.hidden = true;\n  ui.start.hidden = true;\n  ui.running.hidden = false;\n  ui.cheer.textContent = 'よーい、スタート！ もぐらが顔を出すよ。';\n  showTime(config.duration * 1000);\n  soundEffect(effect, audioUrl('sounds/sfx/click.wav'));\n  if (!muted) play(music);\n  ui.field.focus({preventScroll:true});\n  began = performance.now();\n  nextMole = began + 270;\n  publish();\n  timer = setInterval(tick, 40);\n}\nfunction finish() {\n  if (phase !== 'playing') return;\n  phase = 'finished';\n  clearInterval(timer);\n  clearActive();\n  if (lastFeedback >= 0) holes[lastFeedback].classList.remove('hit');\n  holes.forEach(hole => { hole.disabled = true; });\n  showTime(0);\n  const first = best === null;\n  const record = !first && score > best;\n  best = first ? score : Math.max(best, score);\n  ui.finalScore.textContent = score;\n  ui.best.textContent = best;\n  ui.record.hidden = false;\n  ui.resultNote.textContent = record ? '最高記録を更新！' : `最高記録は ${best} 匹`;\n  ui.cheer.textContent = record ? `${score}匹で新記録！ おめでとう！` : score ? `${score}匹ゲット！ おつかれさま！` : 'おつかれさま！ 次は最初の1匹をねらおう。';\n  ui.running.textContent = 'タイムアップ';\n  ui.curtain.hidden = false;\n  ui.retry.focus({preventScroll:true});\n  stopMusic();\n  soundEffect(effect, finishUrl);\n  publish('whack_finished');\n}\nfunction startFromButton() {\n  ui.running.textContent = 'プレイ中';\n  start();\n}\nui.start.addEventListener('click', startFromButton);\nui.retry.addEventListener('click', startFromButton);\nwindow.addEventListener('keydown', event => {\n  if (phase !== 'playing' || event.repeat || event.ctrlKey || event.metaKey || event.altKey || !/^[1-9]$/.test(event.key)) return;\n  event.preventDefault();\n  hit(Number(event.key) - 1);\n});\nwindow.whackGarden = {\n  status: snapshot,\n  setDuration(seconds) {\n    if (phase !== 'ready' || !Number.isInteger(seconds) || seconds < 10 || seconds > 120) return;\n    config.duration = seconds;\n    ui.tagline.textContent = `顔を出したもぐらを、${seconds}秒で何匹たたけるかな？`;\n    showTime(seconds * 1000);\n    publish();\n  },\n  react(roundNumber, expectedPhase, message) {\n    if (round === roundNumber && phase === expectedPhase && typeof message === 'string') ui.cheer.textContent = message;\n  }\n};\npublish();\n</script>\n</body>\n</html>"
  }
 ],
 "state": {},
 "timelines": {},
 "scripts": {
  "whack-settings": "const elementId = 'whack-garden';\nconst page = sg.element(elementId);\nconst seconds = sg.get('whackDuration');\nif (typeof page?.html === 'string' && Number.isInteger(seconds) && seconds >= 10 && seconds <= 120) {\n  const html = page.html\n    .replace(/const config = \\{ duration: \\d+ \\};/, `const config = { duration: ${seconds} };`)\n    .replace(/顔を出したもぐらを、\\d+秒で何匹たたけるかな？/, `顔を出したもぐらを、${seconds}秒で何匹たたけるかな？`)\n    .replace(/(<span id=\"time\">)\\d+(<\\/span>)/, (_, before, after) => `${before}${seconds}${after}`);\n  if (html !== page.html) sg.update(elementId, {html});\n}"
