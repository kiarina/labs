#!/usr/bin/env bash
#MISE description="Build and open the macOS app. CODEX_FLUTTER_CWD sets the project, CODEX_FLUTTER_PROMPT sends one message on start, CODEX_FLUTTER_ACCESS is read-only|agent|full"
set -euo pipefail

(cd app && flutter build macos --debug)
args=()
for name in CODEX_BIN CODEX_FLUTTER_CWD CODEX_FLUTTER_PROMPT CODEX_FLUTTER_ACCESS; do
  if [ -n "${!name:-}" ]; then args+=(--env "$name=${!name}"); fi
done
open -n "${args[@]}" app/build/macos/Build/Products/Debug/codex_flutter.app
