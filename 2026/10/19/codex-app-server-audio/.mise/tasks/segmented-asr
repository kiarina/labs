#!/usr/bin/env bash
#MISE description="Opt-in segmented ChatGPT ASR experiment, macOS"
set -euo pipefail
cd "$(dirname "$0")/../.."
if [[ "${ASR_SKIP_BUILD:-0}" != 1 ]]; then
 mise run //:test-assets:download
 python3 tools/prepare_asr.py
 (cd asr/app && flutter pub get && flutter build macos --release)
fi
rm -f work/asr-control.json
uv run --with-requirements tools/requirements.txt python tools/asr_server.py > work/asr-server.log 2>&1 &
backend=$!
trap 'kill "$backend" 2>/dev/null || true' EXIT INT TERM
for ((n=0;n<100;n++)); do
 [[ -f work/asr-control.json ]] && break
 kill -0 "$backend" || exit 1
 sleep 0.1
done
export ASR_LAB_URL="$(python3 -c 'import json; print(json.load(open("work/asr-control.json"))["url"])')"
if [[ "${ASR_AUTOTEST:-0}" == 1 ]]; then
 "asr/app/build/macos/Build/Products/Release/Speaker ASR Lab.app/Contents/MacOS/Speaker ASR Lab"
else
 /usr/bin/open -W -n --env "ASR_LAB_URL=$ASR_LAB_URL" --stdout "$PWD/work/asr-app.log" --stderr "$PWD/work/asr-app-stderr.log" "$PWD/asr/app/build/macos/Build/Products/Release/Speaker ASR Lab.app"
fi
