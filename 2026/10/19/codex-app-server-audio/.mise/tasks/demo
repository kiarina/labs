#!/usr/bin/env bash
#MISE description="Build and open the macOS record / ChatGPT voice / Thinker demo"
set -euo pipefail
cd "$(dirname "$0")/../.."
mkdir -p work/thinker-sandbox
tools/prepare_delegation.sh
mkdir -p demo/app/assets
ffmpeg -y -loglevel error -f s16le -ar 24000 -ac 1 -i work/delegation-request.pcm -f s16le -ar 48000 -ac 1 demo/app/assets/probe.pcm
(cd demo/app && flutter pub get && flutter build macos --release)
rm -f work/demo-control.json
uv run --with-requirements tools/requirements.txt python tools/demo_server.py > work/demo-server.log 2>&1 &
backend=$!
trap 'kill "$backend" 2>/dev/null || true' EXIT INT TERM
for ((n=0;n<100;n++)); do
  [[ -f work/demo-control.json ]] && break
  kill -0 "$backend" || { cat work/demo-server.log; exit 1; }
  sleep 0.1
done
export VOICE_LAB_URL="$(python3 -c 'import json; print(json.load(open("work/demo-control.json"))["url"])')"
"demo/app/build/macos/Build/Products/Release/Voice Thinker Lab.app/Contents/MacOS/Voice Thinker Lab"
