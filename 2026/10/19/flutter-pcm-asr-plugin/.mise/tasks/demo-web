#!/usr/bin/env bash
#MISE description="Build the demo for the Web and serve it at http://127.0.0.1:8766/ (open in Google Chrome; the mic needs localhost or https)"
set -euo pipefail
cd "$(dirname "$0")/../.."
mise run demo-prepare
(cd demo && flutter pub get && flutter build web --release)
echo "Serving http://127.0.0.1:8766/ (Ctrl-C to stop)"
cd demo/build/web && python3 -m http.server 8766 --bind 127.0.0.1
