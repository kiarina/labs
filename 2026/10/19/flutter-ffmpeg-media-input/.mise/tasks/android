#!/usr/bin/env bash
#MISE description="Build profile APK; set ANDROID_SERIAL to install and run it"
set -euo pipefail
cd "$(dirname "$0")/../.."
(cd app && flutter build apk --profile --target-platform android-arm64 --dart-define=AUTO=file)
if [ -n "${ANDROID_SERIAL:-}" ]; then
 adb -s "$ANDROID_SERIAL" install -r app/build/app/outputs/flutter-apk/app-profile.apk
 adb -s "$ANDROID_SERIAL" shell am force-stop dev.lab.media_input_lab
 adb -s "$ANDROID_SERIAL" shell am start -n dev.lab.media_input_lab/.MainActivity
fi
