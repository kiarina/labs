#!/usr/bin/env bash
#MISE description="Serve the lab's models/ (the converted YAMNet) on :8799 with CORS for the app"
set -euo pipefail
cd "$(dirname "$0")/../../models"
exec python3 - <<'PY'
import http.server, functools
class H(http.server.SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cross-Origin-Resource-Policy", "cross-origin")
        super().end_headers()
http.server.ThreadingHTTPServer(("0.0.0.0", 8799), H).serve_forever()
PY
