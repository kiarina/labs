#!/usr/bin/env bash
#MISE description="Generate, evaluate and audit all conditions (needs REFERENCE_WAV, REFERENCE_TRANSCRIPT_FILE)"
set -euo pipefail
: "${REFERENCE_WAV:?}" "${REFERENCE_TRANSCRIPT_FILE:?}"
uv run python bench.py --reference "$REFERENCE_WAV" --transcript-file "$REFERENCE_TRANSCRIPT_FILE" --output output
for out in output; do
  uv run python evaluate.py --reference "$REFERENCE_WAV" --transcript-file "$REFERENCE_TRANSCRIPT_FILE" --output "$out" --asr
  uv run python audit.py --output "$out"
  uv run python replay.py --output "$out"
  uv run python listen.py --output "$out"
  uv run python summarize.py --output "$out" --export "results/${out#output}80ms"
done
