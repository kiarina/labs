#!/usr/bin/env bash
#MISE description="Compare explicit reference and target boundaries"
set -euo pipefail
: "${REFERENCE_WAV:?Set REFERENCE_WAV to the complete reference WAV}"
: "${REFERENCE_TRANSCRIPT_FILE:?Set REFERENCE_TRANSCRIPT_FILE to its transcript text file}"
uv sync --frozen
uv run --frozen python bench.py --reference "$REFERENCE_WAV" --transcript-file "$REFERENCE_TRANSCRIPT_FILE" "$@"
