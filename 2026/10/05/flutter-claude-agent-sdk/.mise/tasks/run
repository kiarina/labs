#!/usr/bin/env bash
#MISE description="Build and open the macOS app. CLAUDE_FLUTTER_CWD sets the project, CLAUDE_FLUTTER_PROMPT sends one message on start, CLAUDE_FLUTTER_MODE is a permission mode"
# Needs `claude auth login` once (the SDK uses Claude Code's own login).
set -euo pipefail

(cd sidecar && npm install --silent)
(cd app && flutter build macos --debug)
args=(--env "CLAUDE_FLUTTER_SIDECAR=$PWD/sidecar" --env "NODE_BIN=$(command -v node)")
for name in CLAUDE_FLUTTER_CWD CLAUDE_FLUTTER_PROMPT CLAUDE_FLUTTER_MODE CLAUDE_FLUTTER_STATE_DIR; do
  if [ -n "${!name:-}" ]; then args+=(--env "$name=${!name}"); fi
done
# `open` hands the caller's environment to the app. Start it from an empty
# environment, like Finder does, so nothing from the calling shell (for
# example a Claude Code host's CLAUDECODE / CLAUDE_CODE_* / ANTHROPIC_BASE_URL)
# reaches Claude Code.
env -i HOME="$HOME" USER="$USER" LOGNAME="$USER" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  open -n "${args[@]}" app/build/macos/Build/Products/Debug/claude_flutter.app
