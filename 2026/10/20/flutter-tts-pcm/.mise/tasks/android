#!/usr/bin/env bash
#MISE description="Install the release APK on the connected Android device, run the probe and write results/android-<label>.json"
# ANDROID_SERIAL picks the device when more than one is connected.
set -euo pipefail
label=${1:-1}
adb=${ADB:-adb}
pkg=com.kiarina.labs.tts_app
(cd app && flutter build apk --release)
"$adb" install -r app/build/app/outputs/flutter-apk/app-release.apk
"$adb" shell am force-stop $pkg
"$adb" logcat -c
cfg=$(python3 -c "import base64;print(base64.urlsafe_b64encode(b'{\"exit\":true}').decode())")
"$adb" shell am start -n $pkg/.MainActivity --es config "$cfg" >/dev/null
mkdir -p results
for _ in $(seq 1 120); do
  sleep 5
  log=$("$adb" logcat -d -s flutter)
  tot=$(grep -o "TTS_PART [0-9]*/[0-9]*" <<<"$log" | head -1 | cut -d/ -f2 || true)
  n=$(grep -c "TTS_PART" <<<"$log" || true)
  if [ -n "$tot" ] && [ "$n" -ge "$tot" ]; then
    grep TTS_PART <<<"$log" | sed -E 's/^.*TTS_PART [0-9]+\/[0-9]+ //' | tr -d '\n' |
      python3 -m json.tool --no-ensure-ascii > "results/android-$label.json"
    echo "results/android-$label.json"
    exit 0
  fi
done
echo "no result" >&2
exit 1
