#!/usr/bin/env bash
#MISE description="Build qwentts.cpp (Metal), fetch the weights, and run every Mac configuration over the seven sentences"
set -euo pipefail
mise run //:test-assets:download v1 labs-assets-v1
cd "$(dirname "$0")/../.."
[ -d vendor/qwentts.cpp ] || git clone --recurse-submodules https://github.com/ServeurpersoCom/qwentts.cpp.git vendor/qwentts.cpp
git -C vendor/qwentts.cpp checkout -q 5916bf7c79dbb4e66fc059cdc507a79a23a28bb4
git -C vendor/qwentts.cpp submodule update -q --init --recursive
cmake -S vendor/qwentts.cpp -B vendor/qwentts.cpp/build -DCMAKE_BUILD_TYPE=Release -DGGML_METAL=ON
cmake --build vendor/qwentts.cpp/build --config Release -j
uv run --frozen download.py
for talker in 1.7b-base-Q8_0 1.7b-base-BF16 1.7b-base-Q4_K_M 0.6b-base-Q8_0; do uv run --frozen bench.py qwentts --talker "$talker"; done
uv run --frozen bench.py qwentts --talker 1.7b-base-Q8_0 --xvector
uv run --frozen bench.py llama
uv run --frozen bench.py mlx
uv run --frozen concurrency.py
uv run --frozen evaluate.py
