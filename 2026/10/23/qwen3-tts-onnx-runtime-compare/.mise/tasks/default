#!/usr/bin/env bash
#MISE description="Download the ports, check the codec against MLX, and run every configuration over the seven sentences"
set -euo pipefail
mise run //:test-assets:download v1 labs-assets-v1
cd "$(dirname "$0")/../.."
uv run --frozen download.py
uv run --frozen parity.py
for precision in int4 fp16 fp32; do uv run --frozen components.py --precision "$precision"; done
uv run --frozen components.py --precision fp32 --provider coreml-static --repeat 3
uv run --frozen bench.py mlx
uv run --frozen bench.py oc --precision fp32 --mode published
for precision in fp32 fp16 int4; do uv run --frozen bench.py oc --precision "$precision" --mode matched; done
uv run --frozen bench.py oc --precision fp32 --mode matched --provider coreml
uv run --frozen bench.py pl --sampling published --threads 8
uv run --frozen evaluate.py
