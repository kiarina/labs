#!/usr/bin/env bash
#MISE description="Benchmark codec streaming at 1, 2, 4, and 8 second segments"
#MISE depends=["setup"]
set -euo pipefail

PORT_DIR=output/mage-vl-mlx
WEIGHTS_DIR=${MAGE_VL_WEIGHTS:-$PORT_DIR/weights/mage-vl-bf16}
VIDEO=../../../../tests/assets/mp4/glass_fall_768x512_24fps_8s_490kb.mp4

# Build only when the image is missing. The build resolves its base image
# against Docker Hub every time, and a slow registry fails the whole run with
# "DeadlineExceeded" even though nothing needs rebuilding. Drop the tag with
# `docker rmi mage-cvprep:0.2.5` to force a rebuild after editing the Dockerfile.
if ! docker image inspect mage-cvprep:0.2.5 > /dev/null 2>&1; then
  docker build --platform linux/arm64 -t mage-cvprep:0.2.5 \
    -f "$PORT_DIR/docker/Dockerfile.cvprep" "$PORT_DIR/docker"
fi

# Two passes over the same video, differing in one thing: whether file segments
# are cut at the capture rate before cv-preinfer sees them. The Web UI always
# resamples, so the second pass is the one that matches live behavior; the first
# is kept as the baseline the improvement is measured against.
#
# 8 fps rather than the 2 fps the frames backend uses, because cv-preinfer runs
# with --min_group_frames 8 and a 1-second segment at 2 fps gives it two frames
# to work with. It fails outright with "no canvases produced".
CV_PREINFER_BIN=$PWD/$PORT_DIR/docker/cv-preinfer \
  "$PORT_DIR/.venv/bin/python" run_matrix.py \
    --repo "$PORT_DIR" \
    --weights "$WEIGHTS_DIR" \
    --video "$VIDEO" \
    --backends codec \
    --segments 1 2 4 8 \
    --runs 3 \
    --max-new-tokens 16 \
    --output output/codec-summary.json

CV_PREINFER_BIN=$PWD/$PORT_DIR/docker/cv-preinfer \
  "$PORT_DIR/.venv/bin/python" run_matrix.py \
    --repo "$PORT_DIR" \
    --weights "$WEIGHTS_DIR" \
    --video "$VIDEO" \
    --backends codec \
    --segments 1 2 4 8 \
    --runs 3 \
    --max-new-tokens 16 \
    --target-fps 8 \
    --resample-codec-input \
    --output output/codec-resampled-summary.json
