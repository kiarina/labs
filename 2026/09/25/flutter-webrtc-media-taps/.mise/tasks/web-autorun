#!/usr/bin/env bash
#MISE description="Build the web app and run the scenarios in headless Chrome with fake camera/mic; writes results/web-*.json"
set -euo pipefail

SECONDS_PER_RUN=${SECONDS_PER_RUN:-12}
PORT=${PORT:-8766}
CHROME=${CHROME:-"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"}

(cd app && flutter build web --release)
mkdir -p results
python3 -m http.server "$PORT" --bind 127.0.0.1 --directory app/build/web >/dev/null 2>&1 &
SERVER=$!
trap 'kill $SERVER' EXIT
sleep 1

for run in "scenario=local:local" "scenario=loopback:loopback" \
  "scenario=audio-loopback:audio-loopback" "scenario=loopback&convert=-1:loopback-full"; do
  query=${run%%:*}
  name=${run##*:}
  profile=$(mktemp -d)
  timeout $((SECONDS_PER_RUN + 40)) "$CHROME" --headless=new --user-data-dir="$profile" \
    --use-fake-device-for-media-stream --use-fake-ui-for-media-stream \
    --autoplay-policy=no-user-gesture-required --enable-logging=stderr --v=0 \
    "http://127.0.0.1:$PORT/?$query&seconds=$SECONDS_PER_RUN" 2>&1 |
    grep -m1 TAPS_RESULT |
    sed -E 's/.*"TAPS_RESULT (.*)", source.*/\1/' |
    python3 -m json.tool > "results/web-$name.json" || true
  rm -rf "$profile"
  echo "results/web-$name.json"
done
