#!/usr/bin/env bash
set -euo pipefail
: "${MIINEKO_FBX:?Set MIINEKO_FBX to the local Tripo FBX path}"
BLENDER_BIN="${BLENDER_BIN:-blender}"
export MIINEKO_UV_REPORT=results/uv-inspection.json
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/inspect_face_uv.py
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/inspect_fbx.py
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/setup_vrm_base.py
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/face_replace.py
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/finish_vrm.py
python3 scripts/verify_vrm.py
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/roundtrip.py
"$BLENDER_BIN" --background --python-exit-code 1 --python scripts/test_spring.py
